<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>keepassview</title>
  <link rel="stylesheet" href="/app.css">
  <script type="application/json" id="app-config">{"idleTimeoutSeconds":{{.IdleTimeoutSeconds}}}</script>
</head>
<body>
  <header class="top-bar">
    <span class="app-title">keepassview</span>
    <input type="search" id="search" placeholder="Search entries…" autocomplete="off" spellcheck="false">
    <button class="btn btn-danger" id="quit-btn">Quit ⏻</button>
  </header>

  <div class="main-area">
    <nav class="groups-pane" id="groups-pane">
      <h2>Groups</h2>
      <div id="groups-tree"></div>
    </nav>

    <main class="entries-pane" id="entries-pane">
      <div class="empty-state" id="entries-empty">Loading…</div>
    </main>

    <div class="resize-handle" id="detail-resize"></div>
    <aside class="detail-pane empty" id="detail-pane">
      <span>Select an entry</span>
    </aside>
  </div>

  <script src="/app.js"></script>
</body>
</html>
